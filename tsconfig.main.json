{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist/main",
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "jsx": "preserve"
  },
  "include": [
    "src/main/**/*",
    "src/shared/types/**/*",
    "src/shared/config/**/*",
    "src/shared/utils/constants.ts",
    "src/shared/utils/helpers.ts",
    "src/test/node-image-composition-config.ts",
    "src/test/node-memorial-card-service.ts",
    "src/test/memorial-card-recovery.ts"
  ],
  "exclude": [
    "src/renderer"
  ]
}
